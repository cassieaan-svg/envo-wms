PGHOST=localhost
PGPORT=5432
PGDATABASE=envo_wms
PGUSER=postgres
PGPASSWORD=
PG_POOL_MAX=10

JWT_SECRET=change-me
PORT=5100

# EnVo integration. ENVO_API_URL is the origin of EnVo's backend with no trailing slash —
# the client appends /hooks/... itself. SERVICE_TOKEN is the shared secret sent as the
# x-service-token header, and must match the value EnVo checks in its own environment.
# Without both, the facility stock lookup and the warehouse-request status callback fail.
ENVO_API_URL=http://localhost:5000
SERVICE_TOKEN=change-me

# Outbox worker. Delivers queued EnVo callbacks every 15s and retries with backoff, so a
# dispatch made while the line is down still reaches EnVo once it returns. Leave it on in
# the warehouse — set to `off` only for tests or a second process that must not send.
# OUTBOX_WORKER=off

# Which deployment this process is. WMS_ORIGIN is 'cloud' or 'cms' and is stamped on every
# inventory row written here, so the two instances stay distinguishable once the local
# central-medical-store WMS exists. WMS_INSTANCE_ID names the particular deployment.
# Defaults to the cloud, which is what an unconfigured install is today. An unrecognised
# WMS_ORIGIN stops the process at startup rather than writing rows nothing will recognise.
# WMS_ORIGIN=cloud
# WMS_INSTANCE_ID=cloud-vm

# Scheduled reconciliation. Compares each batch against its movement ledger and RECORDS what
# it finds — it never corrects anything. Every 6 hours by default; set to `off` for tests or
# a second process that should not run it.
# RECONCILE_WORKER=off
# RECONCILE_INTERVAL_MS=21600000

# ── Instance role (Phase 4) ────────────────────────────────────────────────────
# WMS_ROLE decides which routes are mounted and which writes are permitted. It must agree
# with WMS_ORIGIN above; the process refuses to start otherwise.
#   cloud  master data, EnVo integration, central reporting, read-only mirror of CMS stock
#   cms    the warehouse's operational inventory; never talks to EnVo
# WMS_ROLE=cloud

# Cloud keeps the right to write warehouse stock until the CMS instance is live. Setting this
# to false is the single deliberate act that hands stock authority to CMS — after which Cloud
# can only mirror. Do it once CMS is commissioned and syncing.
# CLOUD_STOCK_AUTHORITY=true

# ── CMS -> Cloud link (CMS instances only) ─────────────────────────────────────
# CLOUD_API_URL is the origin of the Cloud backend. SYNC_TOKEN is a shared secret and is
# deliberately NOT the same as SERVICE_TOKEN: a machine in the warehouse should not hold the
# credential that can talk to EnVo as Cloud.
# CLOUD_API_URL=https://wms.example.org
# SYNC_TOKEN=change-me
# SYNC_WORKER=off
# SYNC_INTERVAL_MS=60000

# ── Master-data staleness policy (CMS) ─────────────────────────────────────────
# Warn the operator after WARN hours; refuse PRICED work (dispatch, fulfilment) after BLOCK.
# Receiving, adjustments and stock counts are never gated — refusing them would stop the
# warehouse recording stock it is physically holding.
# MASTER_DATA_WARN_HOURS=24
# MASTER_DATA_BLOCK_HOURS=72
# How long the cached user roster may still authenticate people with Cloud unreachable.
# RBAC_MAX_STALE_HOURS=72

# ── Local backup (CMS) ─────────────────────────────────────────────────────────
# Between syncs this machine is the only place the warehouse's stock exists. Target RPO is
# one hour, so run scripts/backup.mjs hourly from the OS scheduler.
# BACKUP_DIR=C:/envo-wms-backups
# BACKUP_KEEP_HOURLY=48
# BACKUP_KEEP_DAILY=30

# The id floor for a CMS database, so the two instances never mint the same integer id.
# Applied once by scripts/initCmsInstance.mjs.
# CMS_ID_FLOOR=1000000
