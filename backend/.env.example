# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Configuration (for CORS)
FRONTEND_URL=http://localhost:5173

# ── Local Postgres ──
PGHOST=localhost
PGPORT=5432
PGDATABASE=envo
PGUSER=postgres
PGPASSWORD=your-postgres-password

# ── Auth (JWT) ──
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
