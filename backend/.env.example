PGHOST=localhost
PGPORT=5432
PGDATABASE=envo_wms
PGUSER=postgres
PGPASSWORD=
PG_POOL_MAX=10

JWT_SECRET=change-me
PORT=5100

# EnVo integration. ENVO_API_URL is the origin of EnVo's backend with no trailing slash —
# the client appends /hooks/... itself. SERVICE_TOKEN is the shared secret sent as the
# x-service-token header, and must match the value EnVo checks in its own environment.
# Without both, the facility stock lookup and the warehouse-request status callback fail.
ENVO_API_URL=http://localhost:5000
SERVICE_TOKEN=change-me

# Outbox worker. Delivers queued EnVo callbacks every 15s and retries with backoff, so a
# dispatch made while the line is down still reaches EnVo once it returns. Leave it on in
# the warehouse — set to `off` only for tests or a second process that must not send.
# OUTBOX_WORKER=off
