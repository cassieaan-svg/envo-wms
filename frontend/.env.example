# Supabase project credentials used by the frontend (Vite).
# The frontend uses the PUBLIC anon key — safe to expose in the browser,
# protected by Supabase Row Level Security (RLS).
#
# Local dev: copy this file to ".env" in the frontend/ folder and fill in real values.
# Netlify:   set these under Site settings → Environment variables (no quotes).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
