# Database backups (may contain real data — keep out of version control)
backend/backups/

# OS
Thumbs.db

# Local data dumps, user-provisioning scripts and credential exports (contain
# real facility data / plaintext passwords — never commit)
amc_staging_load.csv
create_new_facility_users.js
new_facility_logins_confirmed.csv
*_logins*.csv

# Local migration dumps (contain real data) — but keep the realtime trigger DDL,
# which the production DB needs (pure schema, no data). Ignore the dir CONTENTS
# (db/_migration/*) rather than the dir itself, so the negation can re-include.
db/_migration/*
!db/_migration/realtime_triggers.sql

# Account handover sheets — plaintext logins for provisioned facility/DSD accounts.
# Never commit these; they exist only to be handed to the site and then deleted.
DSD_Sites_*.csv
DSD_Sites_*.xlsx
