{
  "name": "envo-warehouse",
  "version": "0.1.0",
  "private": true,
  "description": "EnVo Warehouse — central medical store warehouse management",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @envo/wms-backend",
    "dev:web": "npm run dev --workspace @envo/wms-frontend",
    "migrate": "npm run migrate --workspace @envo/wms-backend",
    "create-admin": "npm run create-admin --workspace @envo/wms-backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
